# 기존 파일은 LF로 저장되어 있다. Windows Git의 CRLF 변환으로 전체 파일이 바뀐 것처럼 보이는 것을 막는다.
* text=auto eol=lf

# Unity YAML (씬·프리팹·에셋)
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.mat      text eol=lf merge=unityyamlmerge
*.meta     text eol=lf
*.controller text eol=lf merge=unityyamlmerge
*.anim     text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.fbx binary
*.wav binary
*.mp3 binary
*.ogg binary
*.ttf binary
*.otf binary
*.pdf binary
*.unitypackage binary
*.dll binary
